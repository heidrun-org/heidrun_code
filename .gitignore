# Installed packages, created by the command "pnpm install"
node_modules

# Built output
dist
dist_staging

# Compiled Rust files of the desktop application
packages/apps/desktop_tauri/target

# Schema files that Tauri generates at build time
packages/apps/desktop_tauri/gen

# Folder settings that macOS Finder creates
.DS_Store

# Log files
*.log

# Cache of the VitePress documentation site
packages/auxiliary/website_public/docs/.vitepress/cache

# Local Heidrun Code configuration of one developer
.heidrun/config.json

# Environment variables of one developer, see the file .env.example
.env

# The multi-layer graph of the experiment, which holds the data of the repository
packages/experiments/multi_layer_graph/public/graph.json
