{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heidrun Code",
  "version": "0.3.5",
  "identifier": "dev.heidrun-org.heidrun-code",
  "build": {
    "beforeDevCommand": "pnpm --filter mobile_website build && pnpm --filter web_frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh ../../../scripts/build_command_line_tools.sh && pnpm --filter mobile_website build && pnpm --filter web_frontend build",
    "frontendDist": "../web_frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Heidrun Code",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0B0C0E",
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "target/release/bundled_commands/heidrun_code_ctrl": "binaries/heidrun_code_ctrl",
      "target/release/bundled_commands/heidrun_data": "binaries/heidrun_data",
      "../../auxiliary/heidrun_code_ctrl/skills/heidrun-code-ctrl/": "bundled_skills/heidrun-code-ctrl/",
      "../../../submodules/heidrun_data/packages/heidrun_data/skills/heidrun-data/": "bundled_skills/heidrun-data/"
    },
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
