###############################################################################
###############################################################################
# Heidrun Code: example of the file .env
#
# The file .env holds the environment variables that you want while you work on
# Heidrun Code. This file, .env.example, lists every environment variable that the
# application reads, and explains each one.
#
# How to use it:
#   1. Copy this file to a file named .env at the root of the repository:
#        cp .env.example .env
#   2. In .env, remove the "#" at the start of each variable line that you want.
#   3. Start the application again with: pnpm dev
#
# Rules:
#   - Git ignores the file .env, so your values stay on your computer.
#   - Only Heidrun Code Development reads .env, including its optimised standalone
#     bundle. Installed Heidrun Code never reads .env.
#   - The application looks for .env in the current folder, then in each parent
#     folder. A worktree that has no .env of its own uses the .env of the main
#     checkout.
#   - A variable that is already set in your shell keeps the value of the shell.
#   - The application reads the file once, at the start. After a change, start
#     the application again.
#   - A value is plain text. The program does not expand "~" or "$HOME", so
#     write the full path of a folder.
#   - Every variable in this file stays commented out, so a copy of this file
#     changes nothing until you remove a "#".
#   - When you add code that reads an environment variable, add the variable to
#     this file in the same change. The test of the file environment_file.rs
#     fails when this file and the code do not list the same variables.
###############################################################################
###############################################################################


###############################################################################
# Variables of Heidrun Code
###############################################################################


###############################################################################
# HEIDRUN_CODE_DIR
#
# The folder where Heidrun Code keeps its own data files: the cache of the chats,
# the database of the four data layers, the history, the mobile access, the records
# of the user activity, and the personal macros (macros.json). The command
# line heidrun_code_ctrl reads this variable too.
#
# Use another folder to try Heidrun Code without touching your real data. The
# installed Claude Code status-line files follow this folder too. Development
# ignores this variable; use HEIDRUN_CODE_DEVELOPMENT_DIR for development instead.
#
# Default: ~/.config/heidrun_code, or the former folder ~/.config/heidrun while
# the new folder does not exist.
# Value: the full path of a folder.
###############################################################################
# HEIDRUN_CODE_DIR=/tmp/heidrun_data


###############################################################################
# HEIDRUN_DIR
#
# The former name of the variable HEIDRUN_CODE_DIR, from the time when Heidrun
# Code was called Heidrun. Heidrun Code reads it only when HEIDRUN_CODE_DIR is
# not set. Use HEIDRUN_CODE_DIR in a new file .env.
#
# Default: not set.
# Value: the full path of a folder.
###############################################################################
# HEIDRUN_DIR=/tmp/heidrun_data


###############################################################################
# HEIDRUN_CODE_NGROK
#
# The path of the program ngrok, which opens the ngrok tunnel of the mobile
# access. Use it for a program that is not in a usual folder, or for a test with
# a fake program. The program must be signed in: run "ngrok config
# add-authtoken <your token>" once.
#
# An application that the Finder starts does not get the PATH of your shell, so
# without this variable Heidrun Code looks in the usual places: ~/.local/bin,
# /opt/homebrew/bin, /usr/local/bin, and /usr/bin. When the program is not
# there, the section "Mobile access" of the Settings window says how to install
# it. An empty value is the same as no value.
#
# When the variable is set and the file does not exist, Heidrun Code does not look
# in the usual places.
#
# Default: the first program ngrok that Heidrun Code finds in the usual places.
# Value: the full path of the program ngrok.
###############################################################################
# HEIDRUN_CODE_NGROK=/opt/homebrew/bin/ngrok


###############################################################################
# HEIDRUN_CODE_STATUS_ITEM_DEMO
#
# The status item of the macOS menu bar shows fake agents: two that are
# blocked, one that is finished, and three that are working. The data of the
# window is ignored. Use it to look at the animations of the status item.
#
# Default: not set, the status item shows the real agents.
# Value: any value switches it on, even an empty one. To switch it off, put the
#        "#" back.
###############################################################################
# HEIDRUN_CODE_STATUS_ITEM_DEMO=1


###############################################################################
# HEIDRUN_CODE_STATUS_ITEM_USER_ACTIVITY
#
# The icon of Heidrun Code in the macOS menu bar fades while you are not active in
# front of Heidrun Code, and is normal while you are active. You are active when the
# Heidrun Code window is in front and a keyboard action or a mouse action happened
# less than 5 seconds ago. Use it to check by eye that the detection of the user
# activity works. See https://github.com/heidrun-org/heidrun/issues/440
#
# Default: not set, the icon never fades.
# Value: any value switches it on, even an empty one. To switch it off, put the
#        "#" back.
###############################################################################
# HEIDRUN_CODE_STATUS_ITEM_USER_ACTIVITY=1


###############################################################################
# HEIDRUN_CODE_USER_BIN
#
# The folder where Heidrun Code installs the command lines heidrun_code_ctrl and
# heidrun_data. Heidrun Code sets this variable itself, in the login shell that
# starts the Herdr server, and puts the folder at the start of the PATH of that
# shell. Each pane then finds the two command lines. Heidrun Code replaces the value
# each time that it starts the Herdr server, so a value in the file .env has no
# effect. The line below only shows the name of the variable.
#
# Default: ~/.local/bin, set by Heidrun Code.
# Value: the full path of a folder, set by Heidrun Code. Do not set it yourself.
###############################################################################
# HEIDRUN_CODE_USER_BIN=/Users/me/.local/bin


###############################################################################
# Variables of other programs that Heidrun Code reads
###############################################################################


###############################################################################
# CLAUDE_CONFIG_DIR
#
# The folder where Claude Code keeps its settings, its plugins, and its chats.
# Heidrun Code reads the chats and the plugins there, and writes the status line in
# the file settings.json there. An empty value is the same as no value.
#
# Default: ~/.claude
# Value: the full path of a folder.
###############################################################################
# CLAUDE_CONFIG_DIR=/tmp/claude_config


###############################################################################
# CODEX_HOME
#
# The folder where Codex keeps its sessions. Heidrun Code reads the chats and the
# usage of Codex there. An empty value is the same as no value.
#
# Default: ~/.codex
# Value: the full path of a folder.
###############################################################################
# CODEX_HOME=/tmp/codex_home


###############################################################################
# HERDR_SESSION
#
# The name of the Herdr session that Heidrun Code uses. Without this variable and
# without HERDR_SOCKET_PATH, Heidrun Code uses its own session, named heidrun, and
# stops it when you quit Heidrun Code, unless the setting "Keep agents running after
# quit" is on.
#
# Herdr allows one attach client for each terminal, so two Heidrun Code applications
# in one session refuse the terminals of each other. A development build that
# runs from a worktree of the folder .claude/worktrees therefore uses its own
# session, named heidrun_ followed by the name of the worktree.
#
# When HERDR_SESSION or HERDR_SOCKET_PATH is set, Heidrun Code does not add the
# argument --session to the Herdr commands, and it never stops the session when
# you quit. An empty value is the same as no value.
#
# Default: heidrun, or heidrun_<name of the worktree> for a development build
#          that runs from a worktree.
# Value: the name of a Herdr session.
###############################################################################
# HERDR_SESSION=my_session


###############################################################################
# HERDR_SOCKET_PATH
#
# The full path of the socket of the Herdr session that Heidrun Code uses. It has
# priority over HERDR_SESSION. The effect on the Herdr commands and on the stop
# at quit is the one that HERDR_SESSION describes. An empty value is the same
# as no value.
#
# Default: the file herdr.sock in the folder of the session, inside the folder
#          of the settings of Herdr.
# Value: the full path of a socket file.
###############################################################################
# HERDR_SOCKET_PATH=/tmp/herdr/herdr.sock


###############################################################################
# HERDR_BIN_PATH
#
# The full path of the program herdr. An application that the Finder starts does
# not get the PATH of your shell, so without this variable Heidrun Code looks in the
# usual places: ~/.local/bin, /opt/homebrew/bin, /usr/local/bin, and a few
# others. An empty value is the same as no value.
#
# Default: the first program herdr that Heidrun Code finds in the usual places.
# Value: the full path of the program herdr.
###############################################################################
# HERDR_BIN_PATH=/opt/homebrew/bin/herdr


###############################################################################
# XDG_CONFIG_HOME
#
# The folder of the settings of your programs. Heidrun Code reads the settings of
# Herdr in the folder herdr inside this folder, as Herdr does. An empty value is
# the same as no value.
#
# Default: ~/.config
# Value: the full path of a folder.
###############################################################################
# XDG_CONFIG_HOME=/tmp/xdg_config


###############################################################################
# SHELL
#
# The login shell that Heidrun Code uses to start the Herdr server in the
# background, and to read the PATH of the terminal at the start, so that
# Heidrun Code finds programs such as gh and glab. macOS sets this variable for
# you, so change it only to test another shell.
#
# Default: the value that macOS sets, else /bin/zsh
# Value: the full path of a shell.
###############################################################################
# SHELL=/bin/zsh

###############################################################################
# Development application isolation
#
# pnpm dev and pnpm build:development select Heidrun Code Development by application
# identity, including an optimised standalone bundle. Development ignores an
# inherited HEIDRUN_CODE_DIR, HERDR_SESSION, HERDR_SOCKET_PATH, and pane
# context. Use these deliberate development overrides instead.
# Paths must be absolute. A development data folder must not be the installed
# data folder. A development session cannot be heidrun or default.
###############################################################################
# HEIDRUN_CODE_DEVELOPMENT_DIR=/tmp/heidrun-development
# HEIDRUN_CODE_DEVELOPMENT_SESSION=heidrun_development_test

###############################################################################
# HEIDRUN_CODE_MOBILE_PORT
#
# Default port for a new mobile access configuration (1 to 65535).
# Installed Heidrun Code defaults to 47823. Heidrun Code Development always selects 47824
# as its default. A port saved in mobile.json takes precedence.
###############################################################################
# HEIDRUN_CODE_MOBILE_PORT=47823
