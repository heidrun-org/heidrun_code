{
  "name": "heidrun-code",
  "interface": {
    "displayName": "Heidrun Code Agent Plugins"
  },
  "plugins": [
    {
      "name": "heidrun-code-control",
      "source": {
        "source": "local",
        "path": "./packages/auxiliary/heidrun_code_ctrl"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "heidrun-data",
      "source": {
        "source": "local",
        "path": "./submodules/heidrun_data/packages/heidrun_data"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    }
  ]
}
